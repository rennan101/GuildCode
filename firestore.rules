rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isMasterAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email != null && (
          request.auth.token.email == 'rennan.raffaele@unicap.br' ||
          request.auth.token.email.matches('(?i)rennan\\.raffaele@unicap\\.br') ||
          request.auth.token.email == 'rennancr93@gmail.com' ||
          request.auth.token.email.matches('(?i)rennancr93@gmail\\.com')
        )) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         getUserData().email != null && (
          getUserData().email.matches('(?i)rennan\\.raffaele@unicap\\.br') ||
          getUserData().email.matches('(?i)rennancr93@gmail\\.com')
         ))
      );
    }

    function isTeacher() {
      return isAuthenticated() && (
        isMasterAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (getUserData().role == 'teacher' || getUserData().role == 'admin'))
      );
    }

    // ─── USERS COLLECTION ───
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isAuthenticated() && (
        isMasterAdmin() ||
        isTeacher() ||
        (isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'email'])))
      );
      allow delete: if isOwner(userId) || isTeacher();
    }

    // ─── GUILDS (CLASSES) COLLECTION ───
    match /classes/{classCode} {
      allow read: if isAuthenticated();
      allow create: if isTeacher();
      allow update: if isAuthenticated() && (
                      (resource.data.teacherUid == request.auth.uid) ||
                      isTeacher() ||
                      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['students']) && (
                        (request.resource.data.students.hasAll(resource.data.students) &&
                         request.resource.data.students.size() == resource.data.students.size() + 1 &&
                         request.resource.data.students[request.resource.data.students.size() - 1] == request.auth.uid) ||
                        (resource.data.students.hasAll(request.resource.data.students) &&
                         resource.data.students.size() == request.resource.data.students.size() + 1 &&
                         !request.resource.data.students.hasAny([request.auth.uid]))
                      ))
                    );
      allow delete: if isTeacher() && resource.data.teacherUid == request.auth.uid;
    }

    // ─── TOURNAMENTS COLLECTION ───
    match /tournaments/{tournamentId} {
      allow read: if isAuthenticated();
      allow create: if isTeacher()
                    && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuthenticated() && (
                      (resource.data.createdBy == request.auth.uid) ||
                      isTeacher() ||
                      (request.resource.data.diff(resource.data).affectedKeys().hasAny(['participants', 'status', 'winner', 'finishedAt']))
                    );
      allow delete: if isTeacher() && (resource.data.createdBy == request.auth.uid || isMasterAdmin());
    }

    // ─── CHALLENGES (PVP RANKED) COLLECTION ───
    match /challenges/{challengeId} {
      allow read: if isAuthenticated() && (
                    resource.data.challengerUid == request.auth.uid ||
                    resource.data.targetUid == request.auth.uid ||
                    isTeacher()
                  );
      allow create: if isAuthenticated()
                    && request.resource.data.challengerUid == request.auth.uid;
      allow update: if isAuthenticated() && (
                      resource.data.challengerUid == request.auth.uid ||
                      resource.data.targetUid == request.auth.uid
                    );
      allow delete: if isTeacher() || (isAuthenticated() && resource.data.challengerUid == request.auth.uid);
    }

    // ─── PARTIES (COOPERAÇÃO EM GRUPOS DE 4) ───
    match /parties/{partyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // ─── CHAPTER & ABYSS ACTIVITIES (CUSTOMIZAÇÃO DE MISSÕES) ───
    match /chapter_activities/{docId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher();
    }

    match /abyss_activities/{docId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher();
    }

    // ─── CHAT MESSAGES (GUILDA & PARTY) ───
    match /chat_messages/{msgId} {
      allow read, write: if isAuthenticated();
    }

    // ─── BOSS BATTLE RAIDS (COOPERATIVO ONLINE) ───
    match /raids/{raidId} {
      allow read, write: if isAuthenticated();
    }

    match /raid_history/{historyId} {
      allow read, write: if isAuthenticated();
    }
  }
}
